<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/topAppBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:title="Routes"
        app:navigationIcon="@drawable/ic_arrow_back_24" />

    <EditText
        android:id="@+id/etRouteName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Route name"
        android:layout_marginTop="24dp" />

    <EditText
        android:id="@+id/etStartPoint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Start point"
        android:layout_marginTop="12dp" />

    <EditText
        android:id="@+id/etEndPoint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="End point"
        android:layout_marginTop="12dp" />

    <Button
        android:id="@+id/btnAddRoute"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Add route"
        android:layout_marginTop="24dp" />

    <Button
        android:id="@+id/btnUpdateRoute"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Update route"
        android:layout_marginTop="12dp" />

    <Button
        android:id="@+id/btnDeleteRoute"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Delete route"
        android:layout_marginTop="12dp" />

    <Button
        android:id="@+id/btnViewRouteList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="View list"
        android:layout_marginTop="24dp" />

    <Button
        android:id="@+id/btnBackToMain"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Back to main menu"
        android:layout_marginTop="12dp" />
</LinearLayout>
