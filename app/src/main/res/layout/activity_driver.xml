<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Toolbar superior con botón de regreso -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/topAppBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:title="Driver management"
        app:navigationIcon="@drawable/ic_arrow_back_24" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Nombre del chofer -->
            <EditText
                android:id="@+id/etDriverName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Driver name"
                android:inputType="textPersonName"
                android:minHeight="48dp"
                android:padding="12dp" />

            <!-- Teléfono -->
            <EditText
                android:id="@+id/etDriverPhone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Phone number"
                android:inputType="phone"
                android:minHeight="48dp"
                android:padding="12dp"
                android:layout_marginTop="8dp" />

            <!-- Licencia -->
            <EditText
                android:id="@+id/etDriverLicense"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="License number"
                android:inputType="text"
                android:minHeight="48dp"
                android:padding="12dp"
                android:layout_marginTop="8dp" />

            <!-- Botón AGREGAR -->
            <Button
                android:id="@+id/btnAddDriver"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Add driver"
                android:minHeight="48dp"
                android:layout_marginTop="12dp" />

            <!-- Botón ACTUALIZAR -->
            <Button
                android:id="@+id/btnUpdateDriver"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Update driver"
                android:minHeight="48dp"
                android:layout_marginTop="8dp" />

            <!-- Botón ELIMINAR -->
            <Button
                android:id="@+id/btnDeleteDriver"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Delete driver"
                android:minHeight="48dp"
                android:layout_marginTop="8dp" />

            <!-- Barra de búsqueda -->
            <androidx.appcompat.widget.SearchView
                android:id="@+id/searchDriver"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:queryHint="Search driver"
                android:iconifiedByDefault="false" />

            <!-- Lista de drivers -->
            <ListView
                android:id="@+id/listViewDrivers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:divider="@android:color/darker_gray"
                android:dividerHeight="1dp" />

            <!-- Botón para volver al menú principal -->
            <Button
                android:id="@+id/btnBackToMain"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Back to main menu"
                android:minHeight="48dp"
                android:layout_marginTop="16dp" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
