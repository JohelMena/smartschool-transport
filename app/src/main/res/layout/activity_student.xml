<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Toolbar superior -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/topAppBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:title="Student management"
        app:navigationIcon="@drawable/ic_arrow_back_24" />

    <!-- Contenido desplazable -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Foto + botón -->
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:id="@+id/ivStudentPhoto"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:src="@mipmap/ic_launcher_round"
                    android:scaleType="centerCrop"
                    android:contentDescription="Student photo" />

                <Button
                    android:id="@+id/btnSelectPhoto"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Select photo"
                    android:layout_marginStart="16dp" />
            </LinearLayout>

            <!-- Nombre -->
            <EditText
                android:id="@+id/etStudentName"
                android:hint="Student name"
                android:inputType="textPersonName"
                android:minHeight="48dp"
                android:padding="12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <!-- Grado -->
            <EditText
                android:id="@+id/etStudentGrade"
                android:hint="Student grade"
                android:inputType="text"
                android:minHeight="48dp"
                android:padding="12dp"
                android:layout_marginTop="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <!-- Guardian -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Guardian"
                android:textStyle="bold"
                android:layout_marginTop="12dp" />

            <Spinner
                android:id="@+id/spinnerGuardian"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp" />

            <!-- Botones CRUD -->
            <Button
                android:id="@+id/btnAddStudent"
                android:text="Add Student"
                android:minHeight="48dp"
                android:layout_marginTop="12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <Button
                android:id="@+id/btnUpdateStudent"
                android:text="Update Student"
                android:minHeight="48dp"
                android:layout_marginTop="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <Button
                android:id="@+id/btnDeleteStudent"
                android:text="Delete Student"
                android:minHeight="48dp"
                android:layout_marginTop="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <!-- SearchView -->
            <androidx.appcompat.widget.SearchView
                android:id="@+id/searchStudent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:queryHint="Search student"
                android:iconifiedByDefault="false" />

            <!-- Lista -->
            <ListView
                android:id="@+id/listViewStudents"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:divider="@android:color/darker_gray"
                android:dividerHeight="1dp" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
