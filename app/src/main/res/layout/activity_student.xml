<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:orientation="vertical"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Student name -->
        <EditText
            android:id="@+id/etStudentName"
            android:hint="Student name"
            android:inputType="textPersonName"
            android:autofillHints="name"
            android:minHeight="48dp"
            android:padding="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- Student grade -->
        <EditText
            android:id="@+id/etStudentGrade"
            android:hint="Student grade"
            android:inputType="text"
            android:autofillHints="education"
            android:minHeight="48dp"
            android:padding="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- BtnAdd -->
        <Button
            android:id="@+id/btnAddStudent"
            android:text="Add Student"
            android:minHeight="48dp"
            android:layout_marginTop="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- btnUpdate -->
        <Button
            android:id="@+id/btnUpdateStudent"
            android:text="Update Student"
            android:minHeight="48dp"
            android:layout_marginTop="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- btnDelete -->
        <Button
            android:id="@+id/btnDeleteStudent"
            android:text="Delete Student"
            android:minHeight="48dp"
            android:layout_marginTop="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- search bar -->
        <SearchView
            android:id="@+id/searchStudent"
            android:queryHint="Search student"
            android:layout_marginTop="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- student list -->
        <ListView
            android:id="@+id/listViewStudents"
            android:layout_marginTop="12dp"
            android:divider="@android:color/darker_gray"
            android:dividerHeight="1dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

    </LinearLayout>
</ScrollView>
