<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.johel.smartschoolapp"
    android:versionCode="1"
    android:versionName="1.0" >

    <uses-sdk
        android:minSdkVersion="24"
        android:targetSdkVersion="36" />

    <permission
        android:name="com.johel.smartschoolapp.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        android:protectionLevel="signature" />

    <uses-permission android:name="com.johel.smartschoolapp.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION" />

    <application
        android:allowBackup="true"
        android:appComponentFactory="androidx.core.app.CoreComponentFactory"
        android:debuggable="true"
        android:extractNativeLibs="false"
        android:icon="@mipmap/ic_launcher"
        android:label="SmartSchoolApp"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:testOnly="true"
        android:theme="@style/Theme.SmartSchoolApp" >

        <!-- === ACTIVITIES DEL PROYECTO === -->


        <!-- Pantalla principal -->
        <activity
            android:name="com.johel.smartschoolapp.MainActivity"
            android:exported="true" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Módulo: Estudiantes -->
        <activity
            android:name="com.johel.smartschoolapp.StudentActivity"
            android:exported="false" />

        <!-- Módulo: Rutas -->
        <activity
            android:name="com.johel.smartschoolapp.RouteActivity"
            android:exported="false" />

        <!-- Módulo: Asistencia -->
        <activity
            android:name="com.johel.smartschoolapp.AttendanceActivity"
            android:exported="false" />

        <!-- Módulo: Conductores -->
        <activity
            android:name="com.johel.smartschoolapp.DriverActivity"
            android:exported="false" />

        <!-- Módulo: Autobuses -->
        <activity
            android:name="com.johel.smartschoolapp.BusActivity"
            android:exported="false" />

        <!-- Módulo: Acudientes -->
        <activity
            android:name="com.johel.smartschoolapp.GuardianActivity"
            android:exported="false" />

        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="com.johel.smartschoolapp.androidx-startup"
            android:exported="false" >
            <meta-data
                android:name="androidx.emoji2.text.EmojiCompatInitializer"
                android:value="androidx.startup" />
            <meta-data
                android:name="androidx.lifecycle.ProcessLifecycleInitializer"
                android:value="androidx.startup" />
            <meta-data
                android:name="androidx.profileinstaller.ProfileInstallerInitializer"
                android:value="androidx.startup" />
        </provider>

        <receiver
            android:name="androidx.profileinstaller.ProfileInstallReceiver"
            android:directBootAware="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.DUMP" >
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.INSTALL_PROFILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.SKIP_FILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.SAVE_PROFILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.BENCHMARK_OPERATION" />
            </intent-filter>
        </receiver>
    </application>

</manifest>